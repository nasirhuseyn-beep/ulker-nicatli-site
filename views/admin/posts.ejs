<!DOCTYPE html>
<html lang="az">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Yazılar — Admin Panel</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="admin-wrap">
    <aside class="admin-sidebar">
      <h2>⚙️ Admin</h2>
      <a href="/admin">📊 Dashboard</a>
      <a href="/admin/posts" class="active">📝 Yazılar</a>
      <a href="/admin/books">📚 Kitablar</a>
      <a href="/admin/comments">💬 Şərhlər</a>
      <a href="/admin/settings">⚙️ Sayt Sazlamaları</a>
      <a href="/admin/password">🔒 Şifrə Dəyişmə</a>
      <a href="/" target="_blank">🌐 Sayta bax</a>
      <a href="/admin/logout">🚪 Çıxış</a>
    </aside>

    <main class="admin-main">
      <div class="admin-header">
        <h1>Yazılar</h1>
        <a href="/admin/posts/new" class="btn btn-primary">➕ Yeni yazı</a>
      </div>

      <% if (posts.length === 0) { %>
        <p class="empty">Hələ heç bir yazı yoxdur. İlk yazınızı əlavə edin!</p>
      <% } else { %>
        <table class="admin-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Başlıq</th>
              <th>Kateqoriya</th>
              <th>Tarix</th>
              <th>Əməliyyat</th>
            </tr>
          </thead>
          <tbody>
            <% posts.forEach(p => { %>
              <tr>
                <td>#<%= p.id %></td>
                <td>
                  <a href="/yazi/<%= p.id %>" target="_blank"><%= p.title %></a>
                  <% if (p.image) { %> <span class="badge">📷</span><% } %>
                  <% if (p.video) { %> <span class="badge">🎥</span><% } %>
                </td>
                <td><span class="cat cat-<%= p.category %>"><%= p.category %></span></td>
                <td><%= p.created_at %></td>
                <td class="actions">
                  <a href="/admin/posts/edit/<%= p.id %>" class="btn btn-sm">✏️ Redaktə</a>
                  <form method="POST" action="/admin/posts/delete/<%= p.id %>" style="display:inline;">
                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Bu yazını silmək istədiyinizə əminsiniz?');">🗑️ Sil</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </main>
  </div>
</body>
</html>