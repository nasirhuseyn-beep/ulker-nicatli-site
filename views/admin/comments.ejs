<!DOCTYPE html>
<html lang="az">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Şərhlər — Admin Panel</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="admin-wrap">
    <aside class="admin-sidebar">
      <h2>⚙️ Admin</h2>
      <a href="/admin">📊 Dashboard</a>
      <a href="/admin/posts">📝 Yazılar</a>
      <a href="/admin/books">📚 Kitablar</a>
      <a href="/admin/comments" class="active">💬 Şərhlər</a>
      <a href="/admin/settings">⚙️ Sayt Sazlamaları</a>
      <a href="/admin/password">🔒 Şifrə Dəyişmə</a>
      <a href="/" target="_blank">🌐 Sayta bax</a>
      <a href="/admin/logout">🚪 Çıxış</a>
    </aside>

    <main class="admin-main">
      <h1>Şərhlər</h1>

      <% if (comments.length === 0) { %>
        <p class="empty">Hələ heç bir şərh yoxdur.</p>
      <% } else { %>
        <table class="admin-table">
          <thead>
            <tr>
              <th>Yazı</th>
              <th>Ad</th>
              <th>Şərh</th>
              <th>Tarix</th>
              <th>Status</th>
              <th>Əməliyyat</th>
            </tr>
          </thead>
          <tbody>
            <% comments.forEach(c => { %>
              <tr class="<%= c.approved ? '' : 'row-pending' %>">
                <td><a href="/yazi/<%= c.post_id %>" target="_blank"><%= c.post_title %></a></td>
                <td><strong><%= c.name %></strong></td>
                <td class="comment-text"><%= c.text %></td>
                <td><small><%= c.created_at %></small></td>
                <td>
                  <% if (c.approved) { %>
                    <span class="status status-ok">✅ Təsdiqlənib</span>
                  <% } else { %>
                    <span class="status status-pending">⏳ Gözləyir</span>
                  <% } %>
                </td>
                <td class="actions">
                  <% if (!c.approved) { %>
                    <form method="POST" action="/admin/comments/approve/<%= c.id %>" style="display:inline;">
                      <button type="submit" class="btn btn-sm btn-success">✅ Təsdiq</button>
                    </form>
                  <% } %>
                  <form method="POST" action="/admin/comments/delete/<%= c.id %>" style="display:inline;">
                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Bu şərhi silmək istədiyinizə əminsiniz?');">🗑️ Sil</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </main>
  </div>
</body>
</html>