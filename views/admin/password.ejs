<!DOCTYPE html>
<html lang="az">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Şifrə Dəyişmə — Admin Panel</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="admin-wrap">
    <aside class="admin-sidebar">
      <h2>⚙️ Admin</h2>
      <a href="/admin">📊 Dashboard</a>
      <a href="/admin/posts">📝 Yazılar</a>
      <a href="/admin/books">📚 Kitablar</a>
      <a href="/admin/comments">💬 Şərhlər</a>
      <a href="/admin/settings">⚙️ Sayt Sazlamaları</a>
      <a href="/admin/password" class="active">🔒 Şifrə Dəyişmə</a>
      <a href="/" target="_blank">🌐 Sayta bax</a>
      <a href="/admin/logout">🚪 Çıxış</a>
    </aside>

    <main class="admin-main">
      <h1>🔒 Şifrə Dəyişmə</h1>

      <% if (error) { %>
        <p class="err">❌ <%= error %></p>
      <% } %>

      <% if (success) { %>
        <p class="ok">✅ <%= success %></p>
      <% } %>

      <form method="POST" class="post-form" style="max-width: 500px;">
        <div class="form-group">
          <label>Cari şifrə *</label>
          <input type="password" name="current_password" 
                 placeholder="Hazırkı şifrəniz" required autocomplete="current-password">
        </div>

        <div class="form-group">
          <label>Yeni şifrə *</label>
          <input type="password" name="new_password" 
                 placeholder="Yeni şifrə (min 6 simvol)" required 
                 minlength="6" autocomplete="new-password">
          <small style="color:#999;">Ən azı 6 simvol olmalıdır</small>
        </div>

        <div class="form-group">
          <label>Yeni şifrə (təkrar) *</label>
          <input type="password" name="confirm_password" 
                 placeholder="Yeni şifrəni təkrar yazın" required 
                 minlength="6" autocomplete="new-password">
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary">🔒 Şifrəni dəyiş</button>
          <a href="/admin" class="btn">❌ Ləğv et</a>
        </div>
      </form>

      <div style="margin-top: 40px; padding: 20px; background: #f9f9f9; border-left: 4px solid #d4a373; border-radius: 8px; max-width: 500px;">
        <h3 style="font-size: 14px; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 10px;">💡 Təhlükəsizlik məsləhətləri</h3>
        <ul style="list-style: none; color: #666; font-size: 14px; line-height: 1.8;">
          <li>✅ Ən azı 8 simvol istifadə edin</li>
          <li>✅ Böyük, kiçik hərf, rəqəm və simvol qarışığı</li>
          <li>✅ Adınız, doğum tarixiniz istifadə etməyin</li>
          <li>✅ Şifrəni başqası ilə paylaşmayın</li>
          <li>✅ Müntəzəm olaraq dəyişdirin</li>
        </ul>
      </div>
    </main>
  </div>
</body>
</html>