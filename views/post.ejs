<!DOCTYPE html>
<html lang="az">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= post.title %> — Ülkər Nicatlı</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header>
    <div class="container header-inner">
      <h1><a href="/">Ülkər Nicatlı</a></h1>
      <nav>
        <a href="/">Ana səhifə</a>
        <a href="/kateqoriya/seir">Şeir</a>
        <a href="/kateqoriya/hekaye">Hekayə</a>
        <a href="/kateqoriya/roman">Roman</a>
        <a href="/kateqoriya/koshe">Köşə yazısı</a>
        <a href="/kitablar">📚 Kitablar</a>
      </nav>
    </div>
  </header>

  <main class="container">
    <article class="single-post">
      <span class="cat cat-<%= post.category %>"><%= post.category.toUpperCase() %></span>
      <h1><%= post.title %></h1>
      
      <div class="post-meta-line">
        <span class="date"><%= post.created_at %></span>
        <span class="meta-sep">•</span>
        <span class="stat-line">
          <span title="Baxış sayı">👁️ <%= post.views || 0 %> baxış</span>
          <span class="meta-sep">•</span>
          <span title="Bəyənmə sayı">❤️ <%= post.likes || 0 %> bəyənmə</span>
        </span>
      </div>

      <% if (post.image) { %>
        <img src="<%= post.image %>" alt="<%= post.title %>" class="cover">
      <% } %>

      <% if (post.video) { %>
        <video controls class="cover">
          <source src="<%= post.video %>">
          Brauzeriniz videonu dəstəkləmir.
        </video>
      <% } %>

      <div class="content"><%= post.content %></div>

      <!-- ============ BƏYƏNMƏ DÜYMƏSİ ============ -->
      <div class="like-section">
        <button class="like-btn" id="likeBtn" onclick="likePost(<%= post.id %>)">
          <span class="like-icon">❤️</span>
          <span class="like-text">Bəyən</span>
          <span class="like-count" id="likeCount"><%= post.likes || 0 %></span>
        </button>
        <small class="like-hint">Bəyən, oxuculara tövsiyə et!</small>
      </div>

      <!-- ============ PAYLAŞMA DÜYMƏLƏRİ ============ -->
      <div class="share-buttons">
        <span class="share-label">Paylaş:</span>
        
        <a href="https://www.facebook.com/sharer/sharer.php?u=https://ulker-nicatli.site/yazi/<%= post.id %>" 
           target="_blank" rel="noopener" class="share-btn share-facebook" title="Facebook-da paylaş">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
        </a>
        
        <a href="https://wa.me/?text=<%= post.title %> - https://ulker-nicatli.site/yazi/<%= post.id %>" 
           target="_blank" rel="noopener" class="share-btn share-whatsapp" title="WhatsApp-da paylaş">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
        </a>
        
        <a href="https://t.me/share/url?url=https://ulker-nicatli.site/yazi/<%= post.id %>&text=<%= post.title %>" 
           target="_blank" rel="noopener" class="share-btn share-telegram" title="Telegram-da paylaş">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
          </svg>
        </a>
        
        <button onclick="copyLink('https://ulker-nicatli.site/yazi/<%= post.id %>')" 
                class="share-btn share-copy" title="Linki kopyala">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
        </button>
      </div>
    </article>

    <section class="comments-section">
      <h3>Şərhlər (<%= comments.length %>)</h3>

      <% if (typeof sent !== 'undefined' && sent) { %>
        <p class="ok">✅ Şərhiniz göndərildi. Təsdiqdən sonra yayımlanacaq.</p>
      <% } %>

      <% if (comments.length === 0) { %>
        <p class="empty">Hələ şərh yoxdur. İlk şərhi siz yazın!</p>
      <% } else { %>
        <% comments.forEach(c => { %>
          <div class="comment">
            <div class="comment-head">
              <strong><%= c.name %></strong>
              <small><%= c.created_at %></small>
            </div>
            <p><%= c.text %></p>
          </div>
        <% }) %>
      <% } %>

      <div class="comment-form">
        <h4>Şərh yaz</h4>
        <form method="POST" action="/yazi/<%= post.id %>/comment">
          <input type="text" name="name" placeholder="Adınız" required>
          <textarea name="text" rows="4" placeholder="Şərhinizi yazın..." required></textarea>
          <button type="submit">Göndər</button>
        </form>
      </div>
    </section>

    <a href="/" class="back-link">← Geri qayıt</a>
  </main>

  <footer>
    <div class="container">
      <p>© 2025 Ülkər Nicatlı — Bütün hüquqlar qorunur.</p>
    </div>
  </footer>

  <script>
    // Copy Link
    function copyLink(url) {
      if (navigator.clipboard) {
        navigator.clipboard.writeText(url).then(function() {
          alert('✅ Link kopyalandı!');
        }).catch(function() {
          prompt('Link:', url);
        });
      } else {
        prompt('Link:', url);
      }
    }

    // Like Post
    function likePost(postId) {
      const btn = document.getElementById('likeBtn');
      const count = document.getElementById('likeCount');
      
      const likedPosts = JSON.parse(localStorage.getItem('likedPosts') || '[]');
      
      if (likedPosts.includes(postId)) {
        alert('Siz artıq bu yazını bəyənmisiniz! ❤️');
        return;
      }
      
      fetch('/yazi/' + postId + '/like', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      })
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          count.textContent = data.likes;
          btn.classList.add('liked');
          btn.querySelector('.like-text').textContent = 'Bəyəndiniz';
          
          likedPosts.push(postId);
          localStorage.setItem('likedPosts', JSON.stringify(likedPosts));
        }
      })
      .catch(err => {
        alert('Xəta baş verdi. Yenidən cəhd edin.');
      });
    }

    // Səhifə açıldıqda: artıq bəyənilibmi?
    document.addEventListener('DOMContentLoaded', function() {
      const postId = <%= post.id %>;
      const likedPosts = JSON.parse(localStorage.getItem('likedPosts') || '[]');
      
      if (likedPosts.includes(postId)) {
        const btn = document.getElementById('likeBtn');
        if (btn) {
          btn.classList.add('liked');
          btn.querySelector('.like-text').textContent = 'Bəyəndiniz';
        }
      }
    });
  </script>
</body>
</html>